# Input for the hash-pinned CI tooling lockfile.
#
# These are CI-only tools (linters + security scanners). They are NEVER
# bundled into the PyInstaller EXE, so this is separate from the runtime
# lock (requirements/lock.txt, compiled from pyproject.toml).
#
# Pinning + hashing them satisfies OpenSSF Scorecard Pinned-Dependencies and
# stops a compromised tool release from tampering with CI.
#
# Regenerate the lock after editing this file with scripts/relock.sh, which
# builds all four lock files with the same 14-day cooldown. It targets
# Python 3.11, which every CI tooling job uses (ubuntu-latest +
# actions/setup-python python-version: '3.11'), with --universal so
# version-conditional transitives (e.g. typing-extensions, only required by
# cyclonedx-python-lib on python_version < "3.13") stay in the lock and
# --require-hashes does not fail on 3.11.

pip
ruff
black
pip-audit
zizmor
